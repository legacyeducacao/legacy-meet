# 1. Copy this file and rename it to .env.local
# 2. Update the enviroment variables below.

# REQUIRED SETTINGS
# #################
# If you are using LiveKit Cloud, the API key and secret can be generated from the Cloud Dashboard.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL pointing to the LiveKit server. (example: `wss://my-livekit-project.livekit.cloud`)
LIVEKIT_URL=

# Supabase — autenticação e banco de dados
# Encontre em: https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key do projeto>
# service_role — NUNCA expor no cliente; usar somente em código server
SUPABASE_SERVICE_ROLE_KEY=<service_role key — server only>
# UUID do tenant sentinela "Comercial" (definido na Task 2 do plano de fundação)
MEET_COMMERCIAL_TENANT_ID=<uuid do tenant sentinela "Comercial">


# OPTIONAL SETTINGS
# ################# 
# Recording (S3 / MinIO)
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=

# Transcrição pós-reunião (worker) — ver worker/README.md e worker/MIGRATION.md
# TRANSCRIPTION_PROVIDER=gemini|assemblyai (padrão: gemini)
# OpenRouter: só o provider gemini usa
# OPENROUTER_API_KEY=
# AssemblyAI: transcrição, diarização e mapeamento de falantes (LLM Gateway) com uma chave só
# ASSEMBLYAI_API_KEY=
# Secret do webhook da AssemblyAI (mesmo valor no app e no worker; sem ele o worker só faz polling)
# ASSEMBLYAI_WEBHOOK_SECRET=

# Login fixo da equipe — protege criar reuniões (home) e o viewer de gravações.
# Convidados entram pelo link da sala sem login.
# STAFF_PASSWORD=

# Integração com CRM — API key para POST /api/meetings (criar sala via agendamento)
# MEETINGS_API_KEY=
# URL pública do app (usada para montar os links das reuniões)
# APP_BASE_URL=https://meet.legacyexecutoria.com.br

# Google Drive (para o app servir vídeos arquivados no Drive)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=

# PUBLIC
# Uncomment settings menu when using a LiveKit Cloud, it'll enable Krisp noise filters.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# Necessário para a gravação automática ao entrar na reunião:
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record

# Cancelamento de ruido Krisp no cliente: auto (so LiveKit Cloud) | off | force
# NEXT_PUBLIC_NOISE_FILTER=auto
# Prefixo dos eventos de telemetria do cliente no MinIO (ver docs/livekit-servidor.md)
# TELEMETRY_PREFIX=telemetry/

# Optional, to pipe logs to datadog
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site

