{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "transcribe.ts",
    "version.ts",
    "lib/**/*.ts",
    "providers/**/*.ts",
    "scripts/**/*.ts"
  ]
}
